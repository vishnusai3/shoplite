# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==========================================
# ShopLite - Full-Stack Configuration
# ==========================================

# Server Port (default 3000)
PORT=3000
NODE_ENV=development

# Frontend Client Public Variables (prefixed with VITE_)
VITE_APP_NAME="ShopLite"
VITE_API_URL="/api"
# Public Supabase credentials for client-side Auth & real-time (optional if backend handles auth)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"
# Razorpay Public Key ID (for Razorpay Standard Checkout in browser)
VITE_RAZORPAY_KEY_ID="rzp_test_YourTestKeyId"

# Backend Private Secrets (NEVER expose to frontend)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# Razorpay Backend Secrets
RAZORPAY_KEY_ID="rzp_test_YourTestKeyId"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret_here"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret_here"

# Initial Super Administrator (provisioned on startup if Supabase not seeded)
INITIAL_ADMIN_EMAIL="admin@shoplite.dev"
INITIAL_ADMIN_PASSWORD="AdminPassword123!"

# CORS Allowed Origin (for separate backend deployment on Render)
CLIENT_URL="http://localhost:3000"

